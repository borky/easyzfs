# EasyZFS — sudoers for a manual install (deploy/install.sh writes the same
# rules, with each binary at the path 'command -v' finds on the host).
# Generated from pinned_sudoers in deploy/install.sh; regenerate rather than
# edit, so the two cannot drift.
#
# Storage tools (zfs, zpool, smartctl, dd, hdparm, udisksctl) are reached
# only through 'easyzfs priv', the privileged gateway in the root-owned
# binary: it checks each command against a closed grammar and the host/guest,
# mountpoint and disk rules before running it. None of the tools is granted
# directly, so the service account cannot skip those checks. See the comment
# on pinned_sudoers for the rest.
#
# The collectors call sudo thousands of times a day and EasyZFS keeps its own
# audit table, so allowed commands and PAM sessions are not logged; refused
# attempts still are.
#
# Install:
#   install -m 0440 -o root -g root deploy/easyzfs.sudoers /etc/sudoers.d/easyzfs
#   visudo -cf /etc/sudoers.d/easyzfs
Defaults:easyzfs !pam_session, !log_allowed
easyzfs ALL=(root) NOPASSWD: /usr/local/bin/easyzfs priv *
easyzfs ALL=(root) NOPASSWD: /usr/bin/fuser ^-sm? /[A-Za-z0-9_./-]+$
easyzfs ALL=(root) NOPASSWD: /usr/bin/lsblk ^-J( -[bd])? -o [A-Z\,]+( /dev/[A-Za-z0-9][A-Za-z0-9_.-]*)?$
easyzfs ALL=(root) NOPASSWD: /usr/bin/crontab -l
easyzfs ALL=(root) NOPASSWD: /usr/local/libexec/easyzfs-sysd
